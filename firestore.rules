rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /lessons/{lessonId} {
      // Future user application: MUST query with status == 'published'.
      allow get, list: if isAdmin() || resource.data.status == 'published';
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['title','youtubeId','categoryId','language','status'])
        && request.resource.data.status in ['published','draft']
        && request.resource.data.language in ['ru','tj','uz'];
      allow update: if isAdmin()
        && request.resource.data.status in ['published','draft']
        && request.resource.data.language in ['ru','tj','uz'];
      allow delete: if isAdmin();
    }

    match /taxonomy/{docId} {
      allow get: if docId == 'catalog';
      allow list: if false;
      allow create, update: if docId == 'catalog' && isAdmin();
      allow delete: if false;
    }

    // No other collections are accessible yet.
    match /{document=**} { allow read, write: if false; }
  }
}
