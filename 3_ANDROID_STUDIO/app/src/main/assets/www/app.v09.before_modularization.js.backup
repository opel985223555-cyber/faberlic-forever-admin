function t(){return UI[currentLang]||UI.ru}
function content(section,id,index=0){
 const row=CONTENT[section]?.[id]?.[currentLang]||CONTENT[section]?.[id]?.ru;
 return row?.[index]||'';
}
function catName(id){return content('categories',id,0)||id}
function videoTitle(id){return content('videos',id,0)||data.videos.find(v=>v.id===id)?.title||id}
function videoDesc(id){return content('videos',id,1)||data.videos.find(v=>v.id===id)?.description||''}

function lockViewport(){document.documentElement.style.setProperty('--app-height',`${window.innerHeight}px`)}

function svgIcon(name){
 const icons={
  spark:'<svg viewBox="0 0 24 24"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/></svg>',
  bars:'<svg viewBox="0 0 24 24"><rect x="4" y="14" width="3" height="6" rx="1"/><rect x="10.5" y="9" width="3" height="11" rx="1"/><rect x="17" y="4" width="3" height="16" rx="1"/></svg>',
  users:'<svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><circle cx="16.5" cy="9" r="2.4"/><path d="M3.5 19c.5-4 2.8-6 5.5-6s5 2 5.5 6zM14 18.8c.4-2.8 1.8-4.4 4-4.4 1.4 0 2.4.7 3 2"/></svg>',
  diamond:'<svg viewBox="0 0 24 24"><path d="M5 5h14l3 5-10 11L2 10z"/><path d="M7.8 5 12 21 16.2 5M2.5 10h19" class="cut"/></svg>',
  heart:'<svg viewBox="0 0 24 24"><path d="M12 20.5S3.5 15.8 3.5 9.8c0-3.3 4.1-5.1 8.5-.8 4.4-4.3 8.5-2.5 8.5.8 0 6-8.5 10.7-8.5 10.7z"/></svg>',
  screen:'<svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="13" rx="2"/><rect x="9" y="19" width="6" height="2" rx="1"/></svg>',
  trophy:'<svg viewBox="0 0 24 24"><path d="M8 4h8v5c0 3-1.8 5-4 5s-4-2-4-5zM10 14h4v4h3v2H7v-2h3z"/><path d="M8 6H4c0 3 1 5 4 5M16 6h4c0 3-1 5-4 5" class="cut"/></svg>',
  team:'<svg viewBox="0 0 24 24"><circle cx="8" cy="8" r="3"/><circle cx="16" cy="8" r="3"/><path d="M2.5 19c.5-4 2.8-6 5.5-6s5 2 5.5 6M10.5 19c.5-4 2.8-6 5.5-6s5 2 5.5 6"/></svg>'
 }; return icons[name]||icons.spark;
}

function getActiveBanners(){return data.banners.filter(b=>b.active)}
function changeBanner(step){
 const arr=getActiveBanners(); if(arr.length<2)return;
 bannerIndex=(bannerIndex+step+arr.length)%arr.length; renderBanners(); restartBannerTimer()
}
function restartBannerTimer(){
 clearInterval(bannerTimer); const arr=getActiveBanners();
 if(arr.length>1)bannerTimer=setInterval(()=>changeBanner(1),3800)
}
function renderBanners(){
 const arr=getActiveBanners(),wrap=$('#heroWrap');
 if(!arr.length){wrap.innerHTML='';return}
 bannerIndex=Math.min(bannerIndex,arr.length-1);
 const b=arr[bannerIndex],text=CONTENT.banners[b.id]?.[currentLang]||CONTENT.banners[b.id]?.ru||[b.label,b.title,b.text];
 wrap.innerHTML=`
 <div class="hero" id="heroBox">
   ${arr.length>1?'<button class="bannerArrow" aria-label="Следующий баннер" onclick="event.stopPropagation();changeBanner(1)"><svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg></button>':''}
   <span class="badge">${esc(text[0])}</span>
   <h1>${esc(text[1])}</h1>
   <p>${esc(text[2])}</p>
   <button class="cta" onclick="openVideo('${b.videoId}')">
     <span>${esc(t().watch)}</span>
     <svg viewBox="0 0 24 24"><path d="M9 5.5 15.5 12 9 18.5"/></svg>
   </button>
 </div>
 <div class="dots">${arr.map((_,i)=>`<button class="dot ${i===bannerIndex?'active':''}" onclick="bannerIndex=${i};renderBanners();restartBannerTimer()"></button>`).join('')}</div>`;
 bindBannerSwipe()
}
function bindBannerSwipe(){
 const hero=$('#heroBox'); if(!hero)return; let sx=0,sy=0;
 hero.addEventListener('touchstart',e=>{const p=e.changedTouches[0];sx=p.clientX;sy=p.clientY},{passive:true});
 hero.addEventListener('touchend',e=>{const p=e.changedTouches[0],dx=p.clientX-sx,dy=p.clientY-sy;if(Math.abs(dx)>42&&Math.abs(dx)>Math.abs(dy))changeBanner(dx<0?1:-1)},{passive:true})
}

function renderChips(){
 $('#chips').innerHTML=`<button class="chip ${activeCategory==='all'?'active':''}" onclick="setCat('all')">${esc(t().all)}</button>`+
 data.categories.slice(0,6).map(c=>`<button class="chip ${activeCategory===c.id?'active':''}" onclick="setCat('${c.id}')">${esc(catName(c.id))}</button>`).join('')
}
function setCat(id){activeCategory=id;renderChips();renderVideos()}
function renderVideos(){
 const q=($('#search')?.value||'').toLowerCase().trim();
 const arr=data.videos.filter(v=>{
   const title=videoTitle(v.id).toLowerCase(),cat=catName(v.category).toLowerCase();
   return (activeCategory==='all'||v.category===activeCategory)&&(!q||title.includes(q)||cat.includes(q))
 }).slice(0,8);
 $('#videoGrid').innerHTML=arr.map(v=>`
 <article class="videoCard" onclick="openVideo('${v.id}')">
   <div class="cover">${v.isNew?`<span class="new">${esc(t().newBadge)}</span>`:''}<span class="playmini">▶</span><span class="time">${esc(v.duration)}</span></div>
   <div class="videoInfo"><span class="kicker">${esc(catName(v.category))}</span><b>${esc(videoTitle(v.id))}</b><small>${v.orientation==='vertical'?esc(t().vertical):esc(t().horizontal)}</small></div>
 </article>`).join('')||`<div class="empty">${esc(t().noSaved)}</div>`
}
function renderCategories(){
 const target=$('#categoryList'); if(!target)return;
 target.innerHTML=data.categories.map(c=>`
 <button class="item" onclick="openCategory('${c.id}')">
   <div class="itemIcon">${svgIcon(c.icon)}</div>
   <div><b>${esc(catName(c.id))}</b><small>${esc(content('categories',c.id,1))}</small></div>
   <span class="arrow">›</span>
 </button>`).join('')
}
function openCategory(id){activeCategory=id;go('home');renderChips();renderVideos();setTimeout(()=>document.querySelector('.chips')?.scrollIntoView({behavior:'smooth',block:'center'}),80)}
function renderLive(){
 const target=$('#liveList'); if(!target)return;
 target.innerHTML=data.live.map(x=>`<div class="item"><div class="itemIcon">LIVE</div><div><b>${esc(content('live',x.id,0))}</b><small>${esc(content('live',x.id,1))}</small></div><span class="arrow">→</span></div>`).join('')
}
function renderMaterials(){
 const target=$('#materialList'); if(!target)return;
 target.innerHTML=data.materials.map(x=>`<div class="item"><div class="itemIcon">${esc(x.type)}</div><div><b>${esc(content('materials',x.id,0))}</b><small>${esc(content('materials',x.id,1))}</small></div><span class="arrow">↓</span></div>`).join('')
}
function renderSaved(){
 const target=$('#savedList'); if(!target)return;
 const ids=savedIds(),arr=data.videos.filter(v=>ids.includes(v.id));
 target.innerHTML=arr.length?`<div class="list">${arr.map(v=>`<button class="item" onclick="openVideo('${v.id}')"><div class="itemIcon">▶</div><div><b>${esc(videoTitle(v.id))}</b><small>${esc(catName(v.category))} · ${esc(v.duration)}</small></div><span class="arrow">›</span></button>`).join('')}</div>`:
 `<div class="empty"><b>${esc(t().noSaved)}</b><br>${esc(t().saveHint)}</div>`
}

function updateStaticUI(){
 document.documentElement.lang=currentLang==='tj'?'tg':currentLang;
 $('#brandSubtitle').textContent=t().brand;
 $('#search').placeholder=t().search;
 $('#continueTitle').textContent=t().continue;
 $('#historyBtn').textContent=t().history;
 $('#newTitle').textContent=t().new;
 $('#allNewBtn').textContent=t().allNew;
 $('#continueVideoTitle').textContent=videoTitle('v2');
 $('#continueVideoMeta').textContent=t().continueMeta;
 $('#categoriesSub').textContent=t().sub.categories;
 $('#liveSub').textContent=t().sub.live;
 $('#materialsSub').textContent=t().sub.materials;
 $('#savedSub').textContent=t().sub.saved;
 $('#lessonHeader').textContent=t().lesson;
 $('#langSheetTitle').textContent=t().languageTitle;
 $('#langSheetSub').textContent=t().languageSub;
 $$('.navLabel').forEach(el=>el.textContent=t().nav[el.dataset.nav]);
 $('#langButtonHome').textContent=t().code;
 $('#langButtonSection').textContent=t().code;
 updateHeader(currentPage);
 $$('.langOption').forEach(el=>el.classList.toggle('active',el.dataset.lang===currentLang))
}
function updateHeader(id){
 const home=id==='home';
 $('#homeHeader').hidden=!home; $('#sectionHeader').hidden=home;
 if(!home)$('#sectionHeaderTitle').textContent=t().page[id]||''
}
function renderAll(){
 updateStaticUI(); renderBanners(); renderChips(); renderVideos(); renderCategories(); renderLive(); renderMaterials(); renderSaved(); restartBannerTimer()
}
function go(id){
 currentPage=id;
 $$('.page').forEach(p=>p.classList.remove('active')); $('#'+id).classList.add('active');
 $$('.nav').forEach(n=>n.classList.toggle('active',n.dataset.page===id));
 updateHeader(id); $('#scrollArea').scrollTo({top:0,behavior:'auto'}); if(id==='saved')renderSaved()
}

function videoYoutubeId(v){
 if(v.youtubeIds&&v.youtubeIds[currentLang])return v.youtubeIds[currentLang];
 if(currentLang==='ru')return v.youtubeId||'';
 return ''
}
function openVideo(id){
 const v=data.videos.find(x=>x.id===id); if(!v)return;
 currentVideoId=id;
 $('#lessonTitle').textContent=videoTitle(v.id);
 $('#lessonCat').textContent=`${catName(v.category)} · ${v.duration} · ${t().code}`;
 $('#lessonDesc').textContent=videoDesc(v.id);
 const p=$('#player'); p.className='player '+(v.orientation==='horizontal'?'horizontal':'vertical');
 const yid=videoYoutubeId(v);
 if(yid){
   p.innerHTML=`<iframe src="https://www.youtube-nocookie.com/embed/${encodeURIComponent(yid)}?playsinline=1" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`
 }else{
   p.innerHTML=`<div id="playerContent"><button class="bigPlay" aria-label="Play"><svg viewBox="0 0 24 24"><path d="M9.2 6.8 17 12l-7.8 5.2z"/></svg></button><small>${esc(t().noVideo)}</small></div>`
 }
 updateFavoriteButton();
 $('#watchedBtn').textContent=t().watched;
 $('#lessonOverlay').classList.add('show')
}
function closeLesson(){$('#lessonOverlay').classList.remove('show');currentVideoId=null}
function heartIcon(){return '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7.15-4.56-9.33-8.24C.46 9.03 3 4.8 6.88 4.8c2.1 0 4 1.03 5.12 2.68 1.12-1.65 3.02-2.68 5.12-2.68 3.88 0 6.42 4.23 4.21 7.96C19.15 16.44 12 21 12 21z"/></svg>'}
function updateFavoriteButton(){
 const saved=savedIds().includes(currentVideoId),btn=$('#favoriteBtn');
 btn.classList.toggle('active',saved);
 btn.innerHTML=heartIcon()+'<span>'+(saved?t().favoriteOn:t().favorite)+'</span>';
}
function toggleCurrentFavorite(){if(!currentVideoId)return;let arr=savedIds();arr=arr.includes(currentVideoId)?arr.filter(x=>x!==currentVideoId):[...arr,currentVideoId];setSaved(arr);updateFavoriteButton();renderSaved()}
function markWatched(){if(!currentVideoId)return;const arr=JSON.parse(localStorage.getItem('ff_watched')||'[]');if(!arr.includes(currentVideoId))arr.push(currentVideoId);localStorage.setItem('ff_watched',JSON.stringify(arr));$('#watchedBtn').textContent=t().watched}

function openLanguageSheet(){$('#langOverlay').classList.add('show');$$('.langOption').forEach(el=>el.classList.toggle('active',el.dataset.lang===currentLang))}
function closeLanguageSheet(){$('#langOverlay').classList.remove('show')}
function setLanguage(lang){
 currentLang=lang; localStorage.setItem('ff_lang',lang); closeLanguageSheet(); renderAll();
 if($('#lessonOverlay').classList.contains('show')&&currentVideoId)openVideo(currentVideoId)
}

function installScrollGuard(){
 const scroller=$('#scrollArea'); if(!scroller)return; let startY=0;
 scroller.addEventListener('touchstart',e=>{if(e.touches.length)startY=e.touches[0].clientY},{passive:true});
 scroller.addEventListener('touchmove',e=>{
   if(!e.touches.length)return; const y=e.touches[0].clientY,dy=y-startY;
   const atTop=scroller.scrollTop<=0,atBottom=Math.ceil(scroller.scrollTop+scroller.clientHeight)>=scroller.scrollHeight;
   if((atTop&&dy>0)||(atBottom&&dy<0))e.preventDefault()
 },{passive:false})
}

window.ffHandleBack=function(){
 if($('#langOverlay').classList.contains('show')){closeLanguageSheet();return true}
 if($('#lessonOverlay').classList.contains('show')){closeLesson();return true}
 if(currentPage!=='home'){go('home');return true}
 return false
}

document.addEventListener('DOMContentLoaded',()=>{
 lockViewport(); renderAll(); installScrollGuard(); $('#search').addEventListener('input',renderVideos)
});
window.addEventListener('orientationchange',()=>setTimeout(lockViewport,350));
